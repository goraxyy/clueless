# Copy this file to .env and fill in ONE of the options. .env is never committed.
# Students need none of this: they sign in to their Clueless account, and Claude runs on our server.
# These options are for developers.

# ── Option C: a Clueless account server other than the built-in one ────────────
# (a staging or local Supabase; the built-in one is in src/main/account/project.ts)
# CLUELESS_SUPABASE_URL=http://127.0.0.1:54321
# CLUELESS_SUPABASE_KEY=sb_publishable_...

# ── Option A: Claude in Amazon Bedrock ─────────────────────────────────────────
AWS_REGION=us-east-1
# Sign in ONE way:
#   1) A Bedrock API key (AWS console → Amazon Bedrock → API keys), the simplest:
AWS_BEARER_TOKEN_BEDROCK=
#   2) An AWS CLI profile (after `aws configure sso` or `aws configure`):
# AWS_PROFILE=
#   3) Access keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Option B: the Claude API ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────
# Models. The tutor (hidden solution, hints) uses Sonnet 5.5; small jobs (Ask on a highlight,
# setting up a code run, follow-ups) use Haiku 5.5. On Bedrock, turn on access to both in the
# Bedrock console first. For the strongest tutor, set CLUELESS_MODEL=anthropic.claude-opus-5-5.
# CLUELESS_MODEL=anthropic.claude-sonnet-5-5
# CLUELESS_FAST_MODEL=anthropic.claude-haiku-5-5
# Force a provider if more than one is set up: clueless (your account), bedrock or anthropic
# CLUELESS_PROVIDER=clueless
# How hard Claude thinks when it traces your code: low | medium | high | xhigh | max.
# Default: medium for short code, high for longer. max is slowest (about 90 s on a small sort).
# CLUELESS_TRACE_EFFORT=high
# Voice: talking to Clueless (speech to text)
# DEEPGRAM_API_KEY=
# Voice: Clueless talking back in a natural voice. Without a key it uses the computer's built-in voice.
# ELEVENLABS_API_KEY=
# Voice name from your ElevenLabs account (add voices in the Voice Library), or a voice ID.
# Empty picks the first of: Talia, Caleb, Maisie, Eddie, Jade, Wyatt, Lawrence.
# ELEVENLABS_VOICE=Talia
# ELEVENLABS_MODEL=eleven_v4_turbo
