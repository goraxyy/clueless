{
  "name": "clueless",
  "version": "0.1.0",
  "description": "A small study helper that walks you through problems with hints instead of answers.",
  "main": "./out/main/index.js",
  "author": "Clueless team",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "try": "tsx scripts/try-tutor.mts",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "trace": "tsx scripts/try-trace.mts",
    "eval": "tsx scripts/model-eval.mts",
    "allowlist": "tsx scripts/server-allowlist.mts",
    "icon": "qlmanage -t -s 1024 -o build build/icon.svg >/dev/null && mv build/icon.svg.png build/icon.png && python3 scripts/icon-corners.py build/icon.png && sips -Z 256 build/icon.png --out ../website/icon.png >/dev/null"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.11",
    "mathjs": "^15.2.0",
    "pyodide": "^314.0.7",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
